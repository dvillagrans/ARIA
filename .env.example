# ============================================================
# ARIA — Environment Variables Reference
# Copy this file to .env and fill in the values.
# Run `supabase status` after `supabase start` to obtain the
# Supabase keys.
# ============================================================

# ----------------------------------------------------------
# Supabase (local dev — update for staging/prod)
# ----------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<from: supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from: supabase status>

# ----------------------------------------------------------
# LLM / Embeddings (not used in Phase 0 — stubs only)
# ----------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=

# ----------------------------------------------------------
# Backend
# ----------------------------------------------------------
ENVIRONMENT=development

# Comma-separated list of origins allowed by the backend CORS policy.
# localhost-only by default; add your production frontend origin when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of hosts allowed to reach the Next.js dev server
# (Next.js allowedDevOrigins). Defaults to localhost only.
ALLOWED_DEV_ORIGINS=

# ----------------------------------------------------------
# Initial user seed (supabase/seed_initial_user.sql, psql 15+)
# Chosen by you; the script refuses unset, empty or weak values.
# ----------------------------------------------------------
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# ----------------------------------------------------------
# Frontend (NEXT_PUBLIC_* are exposed to the browser bundle)
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from: supabase status>
NEXT_PUBLIC_API_URL=http://localhost:8000
